{
  "schema_version": 1,
  "default_channel": "stable",
  "channels": {
    "stable": {
      "description": "Pinned operational baseline for Ubuntu/Debian setups. Prefers distro packages and existing local PDK installations, and falls back to upstream prebuilt PDKs (ciel) or a source build of open_pdks. No maintainer-built artifacts are distributed.",
      "bootstrap": {
        "apt_packages": [
          "git",
          "xschem",
          "ngspice",
          "magic",
          "netgen-lvs",
          "klayout",
          "python3",
          "python3-pip",
          "python3-venv",
          "libxcb-cursor0",
          "libxcb-xinerama0",
          "libxkbcommon-x11-0",
          "libxcb-xkb1",
          "libxcb-icccm4",
          "libxcb-image0",
          "libxcb-keysyms1",
          "libxcb-render-util0",
          "libxcb-randr0",
          "libxcb-shape0",
          "libxcb-xfixes0",
          "libgl1"
        ]
      },
      "pdk": {
        "strategy": "external-managed",
        "managed_root": "~/pdk",
        "managed_install_mode": "symlink",
        "minimum_free_gb": 8,
        "source_build_root": "~/src/pdk-build",
        "source_build_minimum_free_gb": 20,
        "source_build_required_commands": [
          "git",
          "make",
          "gcc",
          "g++",
          "autoconf",
          "automake",
          "libtoolize",
          "aclocal",
          "m4",
          "tclsh",
          "wish",
          "tcsh"
        ],
        "source_build_open_pdks_repo": "https://github.com/RTimothyEdwards/open_pdks.git",
        "source_build_open_pdks_ref": "1.0.608",
        "source_build_configure_args": [
          "--enable-sky130-pdk"
        ],
        "bundle": {
          "enabled": false,
          "name": "sky130a-prebuilt",
          "version": "",
          "install_root": "~/pdk",
          "cache_root": "~/.cache/sky130-flow-gui/pdk",
          "minimum_free_gb": 10,
          "asset_url": "",
          "asset_filename": "",
          "asset_sha256": "",
          "disabled_reason": "Earlier releases shipped a tarball built from a maintainer workstation's ~/pdk/sky130A. That snapshot was not reproducible and carried local modifications, so it is no longer published. Use the 'prebuilt' (ciel) route for a signed upstream build, or build open_pdks from source."
        },
        "preferred_sources": [
          "settings",
          "environment",
          "common-local-roots"
        ],
        "search_roots": [
          "/usr/local/share/pdk",
          "/usr/share/pdk",
          "~/pdk",
          "~/.volare",
          "~/eda/pdk",
          "~/tt-pdk",
          "~/tt-pdk/volare",
          "~/tt-pdk/ciel"
        ],
        "prebuilt": {
          "enabled": true,
          "provider": "ciel",
          "description": "Upstream prebuilt sky130A from fossi-foundation/ciel-releases, managed by the ciel CLI.",
          "install_command": [
            "python3",
            "-m",
            "pip",
            "install",
            "--user",
            "--upgrade",
            "ciel"
          ],
          "pdk_family": "sky130",
          "version": "ff08c23db8359afce3f134c454e7930586d0641c",
          "enable_command": [
            "ciel",
            "enable",
            "--pdk-family",
            "sky130",
            "ff08c23db8359afce3f134c454e7930586d0641c"
          ],
          "pdk_root": "~/.ciel",
          "releases_url": "https://github.com/fossi-foundation/ciel-releases/releases",
          "minimum_free_gb": 6
        }
      },
      "tool_minimum_versions": {
        "magic": "8.3.411",
        "netgen": "1.5.200",
        "xschem": "3.4.4",
        "ngspice": "42",
        "klayout": "0.28"
      },
      "tool_source_builds": {
        "magic": {
          "repo": "https://github.com/RTimothyEdwards/magic.git",
          "ref": "8.3.684",
          "script": "scripts/install_magic_ubuntu.sh"
        },
        "netgen": {
          "repo": "https://github.com/RTimothyEdwards/netgen.git",
          "ref": "1.5.323"
        }
      }
    },
    "latest-tested": {

{
  "schema_version": 1,
  "default_channel": "stable",
  "channels": {
    "stable": {
      "description": "Pinned operational baseline for Ubuntu/Debian setups. Prefer distro packages and existing local PDK installations over live upstream fetches.",
      "bootstrap": {
        "apt_packages": [
          "git",
          "xschem",
          "ngspice",
          "magic",
          "netgen-lvs",
          "klayout",
          "python3",
          "python3-pip",
          "python3-venv",
          "libxcb-cursor0",
          "libxcb-xinerama0",
          "libxkbcommon-x11-0",
          "libxcb-xkb1",
          "libxcb-icccm4",
          "libxcb-image0",
          "libxcb-keysyms1",
          "libxcb-render-util0",
          "libxcb-randr0",
          "libxcb-shape0",
          "libxcb-xfixes0",
          "libgl1"
        ]
      },
      "pdk": {
        "strategy": "external-managed",
        "managed_root": "~/pdk",
        "managed_install_mode": "symlink",
        "minimum_free_gb": 8,
        "source_build_root": "~/src/pdk-build",
        "source_build_minimum_free_gb": 20,
        "source_build_required_commands": [
          "git",
          "make",
          "gcc",
          "g++",
          "autoconf",
          "automake",
          "libtoolize",
          "aclocal",
          "m4",
          "tclsh",
          "wish",
          "tcsh"
        ],
        "source_build_open_pdks_repo": "https://github.com/RTimothyEdwards/open_pdks.git",
        "source_build_open_pdks_ref": "1.0.321",
        "source_build_configure_args": [
          "--enable-sky130-pdk"
        ],
        "bundle": {
          "enabled": true,
          "name": "tt-pdk-sky130a",
          "version": "0.2.0-beta.10",
          "install_root": "~/pdk",
          "cache_root": "~/.cache/sky130-flow-gui/pdk",
          "minimum_free_gb": 10,
          "asset_url": "https://github.com/ROMERUU-dev/sky130-flow-gui/releases/download/v0.2.0-beta.10/tt-pdk-sky130a_0.2.0-beta.10.tar.gz",
          "asset_filename": "tt-pdk-sky130a_0.2.0-beta.10.tar.gz",
          "asset_sha256": "5175df9dea3d3d77b5735fbf8433b750693036ff9046ba61c3423d5c0277acac"
        },
        "preferred_sources": [
          "settings",
          "environment",
          "common-local-roots"
        ],
        "search_roots": [
          "/usr/local/share/pdk",
          "/usr/share/pdk",
          "~/pdk",
          "~/.volare",
          "~/eda/pdk",
          "~/tt-pdk",
          "~/tt-pdk/volare",
          "~/tt-pdk/ciel"
        ]
      }
    },
    "latest-tested": {
      "description": "Reserved channel for newer dependency combinations after explicit validation. Not used automatically yet.",
      "bootstrap": {
        "apt_packages": [
          "git",
          "xschem",
          "ngspice",
          "magic",
          "netgen-lvs",
          "klayout",
